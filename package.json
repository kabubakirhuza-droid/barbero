{
  "name": "barbero",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:mobile": "cd mobile && npm run web",
    "dev": "cd backend && npm run dev",
    "start": "cd mobile && npm start",
    "build:mobile": "cd mobile && npm run build",
    "build:backend": "cd backend && npm run build",
    "typecheck:mobile": "cd mobile && npm run typecheck",
    "typecheck:backend": "cd backend && npm run build",
    "typecheck": "npm run typecheck:backend && npm run typecheck:mobile",
    "build": "cd backend && npm install && npm run build && cd ../mobile && npm install && npm run build && cd .. && node mobile/scripts/patch-web-build.js",
    "test": "node backend/test_e2e.js"
  },
  "dependencies": {
    "@vercel/node": "^5.1.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "web-push": "^3.6.7"
  }
}
