{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "mobile/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/auth/(.*)", "destination": "/api" },
    { "source": "/auth", "destination": "/api" },
    { "source": "/push/(.*)", "destination": "/api" },
    { "source": "/push", "destination": "/api" },
    { "source": "/appointments/(.*)", "destination": "/api" },
    { "source": "/appointments", "destination": "/api" },
    { "source": "/services/(.*)", "destination": "/api" },
    { "source": "/services", "destination": "/api" },
    { "source": "/clients/(.*)", "destination": "/api" },
    { "source": "/clients", "destination": "/api" },
    { "source": "/analytics", "destination": "/api" },
    { "source": "/portfolio/(.*)", "destination": "/api" },
    { "source": "/portfolio", "destination": "/api" },
    { "source": "/profile/(.*)", "destination": "/api" },
    { "source": "/profile", "destination": "/api" },
    { "source": "/public/(.*)", "destination": "/api" },
    { "source": "/public", "destination": "/api" },
    { "source": "/salons/(.*)", "destination": "/api" },
    { "source": "/salons", "destination": "/api" },
    { "source": "/booking-requests/(.*)", "destination": "/api" },
    { "source": "/booking-requests", "destination": "/api" },
    { "source": "/reviews/(.*)", "destination": "/api" },
    { "source": "/reviews", "destination": "/api" },
    {
      "source": "/((?!api/|api$|health$|auth/|push/|appointments/|services/|clients/|analytics$|portfolio/|profile/|public/|salons/|booking-requests/|reviews/|_expo/|favicon.ico|manifest.json|sw.js).*)",
      "destination": "/index.html"
    }
  ]
}
